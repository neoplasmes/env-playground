{
  "name": "@playground/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "check": "pnpm lint && pnpm format:check && tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --config ../../oxlint.config.ts --deny-warnings .",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check .",
    "format": "oxlint --config ../../oxlint.config.ts --fix . && oxfmt --config ../../.oxfmtrc.json --write ."
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
